{
  "name": "yusheng-v2",
  "version": "0.0.1",
  "private": true,
  "description": "余声 v2 — AI 声音记忆陪伴机器人，从 0 重做。Slice 1: 声音克隆最小闭环。",
  "scripts": {
    "dev": "next dev",
    "build": "opennextjs-cloudflare build && rm -rf dist && mkdir -p dist/server && cp -R .open-next/. dist/ && cp scripts/sites-entry.mjs dist/server/index.js && rm -f dist/server-functions/default/.env",
    "build:next": "next build",
    "cf-typegen": "wrangler types --experimental-include-runtime=cloudflare-env.d.ts",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test tests/*.test.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "better-sqlite3": "^11.5.0",
    "next": "^15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3",
    "wrangler": "^4.114.0"
  }
}
