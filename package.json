{
  "name": "yusheng-v2",
  "version": "0.0.1",
  "private": true,
  "description": "余声 v2 — AI 声音记忆陪伴机器人，从 0 重做。Slice 1: 声音克隆最小闭环。",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --pretty false",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --experimental-test-coverage --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/apply-migrations.ts",
    "db:migrate:dry": "node --import tsx scripts/apply-migrations.ts --dry-run",
    "data:migrate:dry": "node --import tsx scripts/migrate-local-data.ts --dry-run",
    "data:migrate": "node --import tsx scripts/migrate-local-data.ts",
    "probe:grounded": "node --import tsx scripts/probe-grounded-behavior.ts",
    "report:restoration": "node --import tsx scripts/report-restoration-feedback.ts",
    "voice-auth:review": "node --import tsx scripts/review-voice-authorization.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/blob": "^2.6.1",
    "better-sqlite3": "^11.5.0",
    "next": "15.5.20",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^6.12.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "tsx": "^4.22.3",
    "typescript": "^5.6.3"
  }
}
