# =====================================================
# 余声 v2 — Slice 3 配置
# 复制为 .env.local 后填值即可
# =====================================================

# SiliconFlow API Key
# 申请：https://cloud.siliconflow.cn/account/ak
SILICONFLOW_API_KEY=

# CosyVoice 模型 ID（默认即可）
COSYVOICE_MODEL=FunAudioLLM/CosyVoice2-0.5B

# ASR 语音识别模型（默认 SenseVoiceSmall）
ASR_MODEL=FunAudioLLM/SenseVoiceSmall

# Embedding 模型（默认 bge-m3）
EMBEDDING_MODEL=BAAI/bge-m3

# LLM 模型（默认 DeepSeek-V3）
LLM_MODEL=deepseek-ai/DeepSeek-V3

# 访问密码（Slice 3 新增）
# 设了密码就必须登录才能用；不设则跳过鉴权（仅限开发）
ACCESS_PASSWORD=

# Session 签名密钥（生产环境务必改掉默认值）
SESSION_SECRET=yusheng-v2-change-me-in-prod

# 每用户每天 TTS 调用上限
TTS_DAILY_LIMIT=50

# 音频上传目录（相对项目根，data/ 已在 .gitignore）
DATA_DIR=./data
